<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>B/J LOGIN MENU - Sci-Fi Neural Interface</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;700;900&family=Rajdhani:wght@600;700&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        :root {
            --bg-deep: #020307;
            --panel-bg: rgba(6, 9, 22, 0.94);
            --border-glow: #00f0ff;
            --border-glow-purple: #b026ff;
            --text-main: #ffffff;
            --text-muted: #cbd5e1;
            --neon-cyan: #00f0ff;
            --neon-purple: #b026ff;
            --neon-pink: #ff007f;
            --neon-yellow: #ffe600;
            --neon-green: #00ff66;
            --cyber-danger: #ff003c;
            --font-head: 'Orbitron', sans-serif;
            --font-body: 'Rajdhani', sans-serif;
            --font-mono: 'Share Tech Mono', monospace;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: var(--font-body);
            user-select: none;
        }

        body {
            background-color: var(--bg-deep);
            color: var(--text-main);
            min-height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
            perspective: 1200px;
            margin: 0;
            padding: 20px;
        }

        /* 3D Canvas Background Layer */
        #cyberCanvas {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
        }

        /* Scanline CRT FX */
        .cyber-scanline {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 240, 255, 0.04) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
            z-index: 3;
            opacity: 1;
            transition: opacity 0.3s ease;
        }

        .ambient-glow {
            position: absolute;
            width: 650px;
            height: 650px;
            background: radial-gradient(circle, rgba(176, 38, 255, 0.28) 0%, rgba(0, 240, 255, 0.18) 40%, rgba(0, 0, 0, 0) 75%);
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 1;
            pointer-events: none;
        }

        /* HUD Corner Elements */
        .hud-display {
            position: absolute;
            font-family: var(--font-mono);
            font-size: 0.8rem;
            color: var(--neon-cyan);
            z-index: 5;
            pointer-events: none;
            letter-spacing: 1.5px;
            background: rgba(3, 5, 14, 0.85);
            padding: 10px 16px;
            border: 1px solid rgba(0, 240, 255, 0.4);
            border-radius: 4px;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.2);
            font-weight: 700;
        }
        .hud-top-left { top: 20px; left: 20px; }
        .hud-top-right { top: 20px; right: 20px; text-align: right; }
        .hud-bottom-left { bottom: 20px; left: 20px; }
        .hud-bottom-right { bottom: 20px; right: 20px; text-align: right; }

        .hud-status-dot {
            display: inline-block;
            width: 10px;
            height: 10px;
            background-color: var(--neon-green);
            border-radius: 50%;
            margin-right: 8px;
            box-shadow: 0 0 10px var(--neon-green);
            animation: pulseFast 1.5s infinite;
        }

        @keyframes pulseFast {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(0.8); }
        }

        /* Centered Panel Layout */
        .login-wrapper {
            position: relative;
            z-index: 10;
            width: 100%;
            max-width: 480px;
            margin: auto;
            display: flex;
            justify-content: center;
            align-items: center;
            transform-style: preserve-3d;
        }

        .login-panel {
            width: 100%;
            background: var(--panel-bg);
            border: 2px solid var(--neon-cyan);
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            padding: 42px 34px 34px 34px;
            position: relative;
            clip-path: polygon(
                0 0, 
                calc(100% - 28px) 0, 
                100% 28px, 
                100% 100%, 
                28px 100%, 
                0 calc(100% - 28px)
            );
            box-shadow: 0 0 45px rgba(0, 240, 255, 0.4), inset 0 0 30px rgba(0, 240, 255, 0.15);
            transition: transform 0.1s cubic-bezier(0.1, 0, 0.1, 1);
        }

        .login-panel::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, transparent 50%, var(--neon-cyan) 50%);
            box-shadow: 0 0 12px var(--neon-cyan);
        }

        /* Top Panel Controls */
        .panel-controls {
            position: absolute;
            top: 14px;
            left: 20px;
            display: flex;
            gap: 10px;
            z-index: 15;
        }

        .ctrl-btn {
            background: rgba(0, 0, 0, 0.85);
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.95rem;
            transition: all 0.2s ease;
            box-shadow: 0 0 10px rgba(0, 240, 255, 0.3);
        }

        .ctrl-btn:hover, .ctrl-btn.active {
            background: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 15px var(--neon-cyan);
        }

        /* Header Title Branding */
        .brand-header {
            text-align: center;
            margin-bottom: 22px;
            margin-top: 5px;
        }

        .brand-logo {
            font-size: 2.6rem;
            color: var(--neon-cyan);
            text-shadow: 0 0 15px var(--neon-cyan), 0 0 30px var(--neon-purple);
            margin-bottom: 6px;
            animation: logoGlow 3s ease-in-out infinite alternate;
        }

        @keyframes logoGlow {
            0% { filter: drop-shadow(0 0 8px var(--neon-cyan)); }
            100% { filter: drop-shadow(0 0 20px var(--neon-pink)); }
        }

        .brand-header h1 {
            font-family: var(--font-head);
            font-size: 2.1rem;
            font-weight: 900;
            letter-spacing: 4px;
            color: #ffffff;
            text-shadow: 0 0 12px rgba(0, 240, 255, 0.9), 0 0 25px rgba(255, 0, 127, 0.8);
            text-transform: uppercase;
            position: relative;
            display: inline-block;
        }

        .brand-header h1 .highlight {
            color: var(--neon-pink);
            text-shadow: 0 0 16px var(--neon-pink), 0 0 35px rgba(255, 0, 127, 1);
        }

        .brand-header p {
            font-family: var(--font-mono);
            color: var(--neon-cyan);
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 2px;
            margin-top: 8px;
            min-height: 1.4em;
            text-shadow: 0 0 8px rgba(0, 240, 255, 0.8);
        }

        /* Navigation Mode Tabs & Arrow Controls */
        .auth-nav-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 22px;
        }

        .auth-tabs {
            flex: 1;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
            background: rgba(0, 0, 0, 0.8);
            padding: 5px;
            border: 1px solid var(--border-glow);
            box-shadow: inset 0 0 12px rgba(0, 240, 255, 0.25);
        }

        .tab-btn {
            background: rgba(15, 23, 42, 0.95);
            border: 1px solid rgba(0, 240, 255, 0.3);
            color: #ffffff;
            font-family: var(--font-head);
            font-size: 0.78rem;
            font-weight: 800;
            padding: 10px 6px;
            cursor: pointer;
            transition: all 0.25s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
            text-align: center;
        }

        .tab-btn:hover {
            color: var(--neon-cyan);
            border-color: var(--neon-cyan);
        }

        .tab-btn.active {
            background: linear-gradient(135deg, rgba(0, 240, 255, 0.35), rgba(176, 38, 255, 0.35));
            color: var(--neon-cyan);
            border: 1.5px solid var(--neon-cyan);
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.5), inset 0 0 10px rgba(0, 240, 255, 0.4);
            text-shadow: 0 0 8px var(--neon-cyan);
        }

        .nav-arrow-btn {
            background: rgba(0, 0, 0, 0.85);
            border: 1px solid var(--neon-cyan);
            color: var(--neon-cyan);
            width: 42px;
            height: 42px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 1.1rem;
            transition: all 0.25s ease;
            box-shadow: 0 0 15px rgba(0, 240, 255, 0.3);
            border-radius: 2px;
        }

        .nav-arrow-btn:hover {
            background: var(--neon-cyan);
            color: #000;
            box-shadow: 0 0 25px var(--neon-cyan);
            transform: scale(1.08);
        }

        /* Social Auth Button */
        .social-auth {
            margin-bottom: 20px;
        }

        .google-btn {
            width: 100%;
            background: #ffffff;
            color: #05060d;
            border: 2px solid #ffffff;
            padding: 12px;
            font-family: var(--font-head);
            font-size: 0.85rem;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            cursor: pointer;
            transition: all 0.25s ease;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.4);
        }

        .google-btn:hover {
            background: var(--neon-cyan);
            color: #000;
            border-color: var(--neon-cyan);
            box-shadow: 0 0 30px var(--neon-cyan);
            transform: translateY(-2px);
        }

        .google-btn i {
            font-size: 1.1rem;
            color: #ea4335;
        }
        .google-btn:hover i {
            color: #000;
        }

        /* Divider */
        .divider {
            display: flex;
            align-items: center;
            text-align: center;
            color: #ffffff;
            font-size: 0.8rem;
            font-weight: 700;
            font-family: var(--font-mono);
            letter-spacing: 2px;
            margin-bottom: 20px;
            text-transform: uppercase;
            text-shadow: 0 0 6px rgba(0, 240, 255, 0.6);
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            border-bottom: 2px solid rgba(0, 240, 255, 0.4);
        }

        .divider::before { margin-right: 15px; }
        .divider::after { margin-left: 15px; }

        /* Form Controls */
        .input-group {
            margin-bottom: 16px;
            position: relative;
        }

        .input-group label {
            display: block;
            font-family: var(--font-head);
            font-size: 0.75rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            color: var(--neon-cyan);
            margin-bottom: 6px;
            text-transform: uppercase;
            text-shadow: 0 0 8px rgba(0, 240, 255, 0.6);
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-wrapper i.input-icon {
            position: absolute;
            left: 16px;
            color: var(--neon-cyan);
            font-size: 1rem;
            transition: all 0.3s ease;
            z-index: 2;
            text-shadow: 0 0 8px var(--neon-cyan);
        }

        .input-field {
            width: 100%;
            background: rgba(3, 5, 15, 0.95);
            border: 2px solid rgba(0, 240, 255, 0.4);
            padding: 12px 45px 12px 48px;
            color: #ffffff;
            font-family: var(--font-body);
            font-size: 1.05rem;
            font-weight: 700;
            letter-spacing: 1px;
            transition: all 0.3s ease;
            outline: none;
            box-shadow: inset 0 0 10px rgba(0, 0, 0, 0.8);
        }

        .input-field::placeholder {
            color: #94a3b8;
            font-weight: 600;
            opacity: 0.9;
        }

        .input-field:focus {
            border-color: var(--neon-cyan);
            background: rgba(0, 240, 255, 0.08);
            box-shadow: 0 0 20px rgba(0, 240, 255, 0.35), inset 0 0 10px rgba(0, 240, 255, 0.2);
            color: #ffffff;
        }

        .input-field:focus + i.input-icon, 
        .input-wrapper:focus-within i.input-icon {
            color: #ffffff;
            transform: scale(1.15);
            text-shadow: 0 0 12px var(--neon-cyan);
        }

        .toggle-password {
            position: absolute;
            right: 16px;
            cursor: pointer;
            color: var(--neon-cyan);
            font-size: 1rem;
            transition: all 0.25s ease;
            z-index: 2;
            text-shadow: 0 0 8px var(--neon-cyan);
        }

        .toggle-password:hover {
            color: #ffffff;
            transform: scale(1.2);
        }

        /* Password Strength Telemetry Bar */
        .password-telemetry {
            margin-top: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .meter-bar-wrapper {
            flex: 1;
            height: 6px;
            background: rgba(255, 255, 255, 0.15);
            border: 1px solid rgba(0, 240, 255, 0.3);
            overflow: hidden;
        }

        .meter-bar-fill {
            height: 100%;
            width: 0%;
            background: var(--cyber-danger);
            transition: width 0.3s ease, background-color 0.3s ease;
            box-shadow: 0 0 8px currentColor;
        }

        .meter-label {
            font-family: var(--font-mono);
            font-size: 0.7rem;
            font-weight: 700;
            color: var(--text-muted);
            min-width: 75px;
            text-align: right;
            letter-spacing: 1px;
        }

        /* Dynamic Register Extra Fields */
        #register-extra-fields {
            display: none;
            animation: fadeIn 0.3s ease-in-out;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(-8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Action Button */
        .action-btn {
            width: 100%;
            background: linear-gradient(135deg, #00f0ff, #b026ff);
            color: #ffffff;
            border: none;
            padding: 15px;
            font-family: var(--font-head);
            font-size: 0.95rem;
            font-weight: 900;
            letter-spacing: 2.5px;
            cursor: pointer;
            text-transform: uppercase;
            transition: all 0.3s ease;
            box-shadow: 0 0 25px rgba(0, 240, 255, 0.6);
            margin-top: 10px;
            position: relative;
            overflow: hidden;
            text-shadow: 0 0 6px #000000;
        }

        .action-btn::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
            transition: left 0.5s ease;
        }

        .action-btn:hover::before {
            left: 100%;
        }

        .action-btn:hover {
            background: linear-gradient(135deg, #ff007f, #00f0ff);
            box-shadow: 0 0 40px rgba(0, 240, 255, 0.8), 0 0 20px rgba(255, 0, 127, 0.6);
            transform: translateY(-2px);
        }

        /* Toast Notifications */
        .toast {
            position: fixed;
            bottom: 35px;
            left: 50%;
            transform: translateX(-50%) translateY(120px);
            background: rgba(3, 5, 15, 0.98);
            border: 2px solid var(--neon-cyan);
            color: #ffffff;
            padding: 14px 28px;
            font-family: var(--font-mono);
            font-size: 0.85rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            box-shadow: 0 0 30px rgba(0, 240, 255, 0.5);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 100;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .toast.show {
            transform: translateX(-50%) translateY(0);
        }

        .toast i {
            color: var(--neon-cyan);
            font-size: 1.2rem;
            text-shadow: 0 0 10px var(--neon-cyan);
        }

        .toast.error {
            border-color: var(--cyber-danger);
            box-shadow: 0 0 30px rgba(255, 0, 60, 0.5);
        }
        .toast.error i {
            color: var(--cyber-danger);
            text-shadow: 0 0 10px var(--cyber-danger);
        }

        /* Corner Decorative Brackets */
        .bracket {
            position: absolute;
            width: 14px;
            height: 14px;
            border: 2px solid var(--neon-cyan);
            pointer-events: none;
            box-shadow: 0 0 8px var(--neon-cyan);
        }
        .bracket-tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
        .bracket-tr { top: -2px; right: 26px; border-left: none; border-bottom: none; }
        .bracket-bl { bottom: -2px; left: 26px; border-right: none; border-top: none; }
        .bracket-br { bottom: -2px; right: -2px; border-left: none; border-top: none; }
    </style>
</head>
<body>
    <!-- 3D Canvas Background -->
    <canvas id="cyberCanvas"></canvas>
    
    <div class="cyber-scanline" id="scanline-overlay"></div>
    <div class="ambient-glow"></div>

    <!-- HUD Telemetry Display -->
    <div class="hud-display hud-top-left">
        <div><span class="hud-status-dot"></span>SYS_STATUS: ONLINE</div>
        <div>NODE_ID: #B/J-CORE-X</div>
    </div>
    <div class="hud-display hud-top-right">
        <div>LATENCY: <span id="hud-ping">14</span>ms</div>
        <div>SEC_LEVEL: DEFCON 1</div>
    </div>
    <div class="hud-display hud-bottom-left">
        <div>ENC: RSA 4096-BIT</div>
        <div>LOC: 127.0.0.1 // PROXY</div>
    </div>
    <div class="hud-display hud-bottom-right">
        <div>MEM: 64.2% OPTIMAL</div>
        <div id="hud-time">00:00:00 UTC</div>
    </div>

    <!-- Main Centered Panel Interface -->
    <main class="login-wrapper">
        <div class="login-panel" id="mainPanel">
            <div class="bracket bracket-tl"></div>
            <div class="bracket bracket-tr"></div>
            <div class="bracket bracket-bl"></div>
            <div class="bracket bracket-br"></div>

            <!-- Panel Controls -->
            <div class="panel-controls">
                <button class="ctrl-btn active" id="toggle-sound" title="Toggle Audio Synthesizer">
                    <i class="fa-solid fa-volume-high"></i>
                </button>
                <button class="ctrl-btn active" id="toggle-fx" title="Toggle 3D Grid & Particle FX">
                    <i class="fa-solid fa-border-all"></i>
                </button>
                <button class="ctrl-btn active" id="toggle-crt" title="Toggle CRT Scanlines Overlay">
                    <i class="fa-solid fa-tv"></i>
                </button>
            </div>

            <!-- Header Title Branding -->
            <header class="brand-header">
                <div class="brand-logo">
                    <i class="fa-solid fa-shield-cat"></i>
                </div>
                <h1><span class="highlight">B/J</span> LOGIN MENU</h1>
                <p id="terminal-subtitle">// INITIALIZING B/J NEURAL INTERFACE v4.0.9...</p>
            </header>

            <!-- Navigation Mode Tabs & Arrow Controls -->
            <div class="auth-nav-container">
                <nav class="auth-tabs" aria-label="Authentication mode">
                    <button class="tab-btn active" type="button" id="tab-signin">SIGN IN AS USER</button>
                    <button class="tab-btn" type="button" id="tab-register">REGISTER</button>
                </nav>
                <button class="nav-arrow-btn" type="button" id="nav-arrow-toggle" title="Switch Mode (Or press Right Arrow)">
                    <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>

            <!-- Social Authentication -->
            <div class="social-auth">
                <button class="google-btn" type="button" id="btn-google">
                    <i class="fa-brands fa-google"></i>
                    <span>Authenticate with Google</span>
                </button>
            </div>

            <div class="divider" id="divider-text">Or User ID Access</div>

            <!-- Form Body -->
            <form id="auth-form" onsubmit="return false;">
                <div class="input-group">
                    <label for="username" id="user-label">User Handle</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input type="text" id="username" class="input-field" placeholder="e.g. B/J_operator_01" required autocomplete="off">
                    </div>
                </div>

                <div class="input-group">
                    <label for="password" id="pass-label">Passcode Cipher</label>
                    <div class="input-wrapper">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input type="password" id="password" class="input-field" placeholder="••••••••••••" required>
                        <i class="fa-solid fa-eye toggle-password" id="togglePassword"></i>
                    </div>
                    
                    <!-- Telemetry Password Strength Bar -->
                    <div class="password-telemetry">
                        <div class="meter-bar-wrapper">
                            <div class="meter-bar-fill" id="meter-fill"></div>
                        </div>
                        <span class="meter-label" id="meter-text">NO DATA</span>
                    </div>
                </div>

                <!-- Registration Extra Field: Passcode Confirmation -->
                <div id="register-extra-fields">
                    <div class="input-group">
                        <label for="confirm-password">Confirm Passcode Cipher</label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-shield-halved input-icon"></i>
                            <input type="password" id="confirm-password" class="input-field" placeholder="••••••••••••">
                            <i class="fa-solid fa-eye toggle-password" id="toggleConfirmPassword"></i>
                        </div>
                    </div>
                </div>

                <button type="submit" class="action-btn" id="btn-submit">INITIALIZE CONNECTION</button>
            </form>
        </div>
    </main>

    <!-- Toast Component -->
    <div class="toast" id="toast">
        <i class="fa-solid fa-circle-check"></i>
        <span>Access Granted. Welcome Operator.</span>
    </div>

    <script>
        // --- Web Audio Synthesizer Engine ---
        class CyberAudioEngine {
            constructor() {
                this.ctx = null;
                this.muted = false;
            }

            init() {
                if (!this.ctx) {
                    const AudioContext = window.AudioContext || window.webkitAudioContext;
                    this.ctx = new AudioContext();
                }
            }

            playTone(freq, type, duration, gainValue = 0.05) {
                if (this.muted) return;
                try {
                    this.init();
                    if (this.ctx.state === 'suspended') this.ctx.resume();
                    const osc = this.ctx.createOscillator();
                    const gain = this.ctx.createGain();
                    osc.type = type;
                    osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
                    gain.gain.setValueAtTime(gainValue, this.ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.0001, this.ctx.currentTime + duration);
                    osc.connect(gain);
                    gain.connect(this.ctx.destination);
                    osc.start();
                    osc.stop(this.ctx.currentTime + duration);
                } catch (e) {}
            }

            playClick() { this.playTone(850, 'sine', 0.04, 0.04); }
            playFocus() { this.playTone(1200, 'triangle', 0.05, 0.02); }
            playSuccess() { 
                this.playTone(523.25, 'sine', 0.1, 0.06); 
                setTimeout(() => this.playTone(659.25, 'sine', 0.1, 0.06), 80);
                setTimeout(() => this.playTone(783.99, 'sine', 0.2, 0.06), 160);
            }
            playError() {
                this.playTone(180, 'sawtooth', 0.15, 0.08);
                setTimeout(() => this.playTone(140, 'sawtooth', 0.2, 0.08), 100);
            }
        }

        const soundEngine = new CyberAudioEngine();

        // --- 3D Particle & Perspective Grid Engine ---
        const canvas = document.getElementById('cyberCanvas');
        const ctx = canvas.getContext('2d');
        let animationFrameId;
        let gridVisible = true;
        let gridOffset = 0;
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            initParticles();
        }

        function initParticles() {
            particles = [];
            const count = Math.floor((canvas.width * canvas.height) / 15000);
            for (let i = 0; i < count; i++) {
                particles.push({
                    x: Math.random() * canvas.width,
                    y: Math.random() * canvas.height,
                    size: Math.random() * 2 + 1,
                    speedY: - (Math.random() * 0.8 + 0.2),
                    speedX: (Math.random() - 0.5) * 0.4,
                    color: Math.random() > 0.5 ? '#00f0ff' : '#b026ff',
                    alpha: Math.random() * 0.7 + 0.3
                });
            }
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        function renderScene() {
            if (!gridVisible) {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                return;
            }

            ctx.fillStyle = '#020307';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            const horizon = canvas.height * 0.45;
            const cx = canvas.width / 2;

            // Perspective Grid Lines
            ctx.lineWidth = 1.2;
            for (let x = -canvas.width * 1.5; x <= canvas.width * 2.5; x += 65) {
                ctx.beginPath();
                ctx.strokeStyle = 'rgba(0, 240, 255, 0.15)';
                ctx.moveTo(cx + (x - cx) * 0.05, horizon);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }

            // Moving Horizontal Grid Lines
            gridOffset = (gridOffset + 0.8) % 40;
            for (let z = 10; z < canvas.height - horizon; z += 40) {
                let currentZ = z + gridOffset;
                let y = horizon + currentZ;
                if (y > canvas.height) continue;
                let alpha = (y - horizon) / (canvas.height - horizon);
                ctx.strokeStyle = `rgba(0, 240, 255, ${alpha * 0.35})`;
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }

            // 3D Particles
            particles.forEach(p => {
                p.y += p.speedY;
                p.x += p.speedX;
                if (p.y < 0) {
                    p.y = canvas.height;
                    p.x = Math.random() * canvas.width;
                }

                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.alpha;
                ctx.shadowColor = p.color;
                ctx.shadowBlur = 8;
                ctx.fill();
                ctx.shadowBlur = 0;
                ctx.globalAlpha = 1.0;
            });

            animationFrameId = requestAnimationFrame(renderScene);
        }
        renderScene();

        // --- HUD Telemetry Updates ---
        function updateHUD() {
            const now = new Date();
            document.getElementById('hud-time').textContent = now.toISOString().substring(11, 19) + ' UTC';

            if (Math.random() > 0.7) {
                document.getElementById('hud-ping').textContent = Math.floor(10 + Math.random() * 8);
            }
        }
        setInterval(updateHUD, 1000);
        updateHUD();

        // --- Terminal Typing Effect ---
        const subTitles = [
            "// INITIALIZING B/J NEURAL INTERFACE v4.0.9...",
            "// B/J SYSTEM ONLINE // STANDBY...",
            "// RSA-4096 ENCRYPTION ACTIVE",
            "// B/J SECURE NODE: ESTABLISHED"
        ];
        let subIndex = 0;
        let charIndex = 0;
        let isDeleting = false;
        const subElem = document.getElementById('terminal-subtitle');

        function typeTerminal() {
            const currentStr = subTitles[subIndex];
            if (isDeleting) {
                subElem.textContent = currentStr.substring(0, charIndex--);
            } else {
                subElem.textContent = currentStr.substring(0, charIndex++);
            }

            let typeSpeed = isDeleting ? 30 : 60;
            if (!isDeleting && charIndex === currentStr.length + 1) {
                typeSpeed = 2200;
                isDeleting = true;
            } else if (isDeleting && charIndex === 0) {
                isDeleting = false;
                subIndex = (subIndex + 1) % subTitles.length;
                typeSpeed = 400;
            }
            setTimeout(typeTerminal, typeSpeed);
        }
        typeTerminal();

        // --- Password Strength Meter ---
        const passwordInput = document.getElementById('password');
        const meterFill = document.getElementById('meter-fill');
        const meterText = document.getElementById('meter-text');

        passwordInput.addEventListener('input', (e) => {
            const val = e.target.value;
            let score = 0;
            if (val.length > 0) score += 20;
            if (val.length >= 8) score += 30;
            if (/[A-Z]/.test(val)) score += 15;
            if (/[0-9]/.test(val)) score += 15;
            if (/[^A-Za-z0-9]/.test(val)) score += 20;

            meterFill.style.width = score + '%';

            if (score === 0) {
                meterText.textContent = 'NO DATA';
                meterText.style.color = 'var(--text-muted)';
                meterFill.style.backgroundColor = 'transparent';
            } else if (score < 50) {
                meterText.textContent = 'CRITICAL';
                meterText.style.color = 'var(--cyber-danger)';
                meterFill.style.backgroundColor = 'var(--cyber-danger)';
            } else if (score < 80) {
                meterText.textContent = 'SECURE';
                meterText.style.color = 'var(--neon-yellow)';
                meterFill.style.backgroundColor = 'var(--neon-yellow)';
            } else {
                meterText.textContent = 'ENCRYPTED';
                meterText.style.color = 'var(--neon-green)';
                meterFill.style.backgroundColor = 'var(--neon-green)';
            }
        });

        // Toggle Password Visibilities
        const togglePassword = document.getElementById('togglePassword');
        togglePassword.addEventListener('click', () => {
            soundEngine.playClick();
            const isPassword = passwordInput.getAttribute('type') === 'password';
            passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
            togglePassword.classList.toggle('fa-eye');
            togglePassword.classList.toggle('fa-eye-slash');
        });

        const confirmPasswordInput = document.getElementById('confirm-password');
        const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
        toggleConfirmPassword.addEventListener('click', () => {
            soundEngine.playClick();
            const isPassword = confirmPasswordInput.getAttribute('type') === 'password';
            confirmPasswordInput.setAttribute('type', isPassword ? 'text' : 'password');
            toggleConfirmPassword.classList.toggle('fa-eye');
            toggleConfirmPassword.classList.toggle('fa-eye-slash');
        });

        // --- Auth Tabs & Dynamic Form Switching ---
        const tabSignIn = document.getElementById('tab-signin');
        const tabRegister = document.getElementById('tab-register');
        const submitBtn = document.getElementById('btn-submit');
        const extraFields = document.getElementById('register-extra-fields');
        const navArrowBtn = document.getElementById('nav-arrow-toggle');

        function setMode(mode) {
            soundEngine.playClick();
            if (mode === 'signin') {
                tabSignIn.classList.add('active');
                tabRegister.classList.remove('active');
                extraFields.style.display = 'none';
                confirmPasswordInput.removeAttribute('required');
                submitBtn.textContent = 'INITIALIZE CONNECTION';
                navArrowBtn.innerHTML = '<i class="fa-solid fa-arrow-right"></i>';
                navArrowBtn.title = 'Switch to REGISTER (Right Arrow)';
            } else {
                tabRegister.classList.add('active');
                tabSignIn.classList.remove('active');
                extraFields.style.display = 'block';
                confirmPasswordInput.setAttribute('required', 'true');
                submitBtn.textContent = 'REGISTER ACCOUNT';
                navArrowBtn.innerHTML = '<i class="fa-solid fa-arrow-left"></i>';
                navArrowBtn.title = 'Switch to SIGN IN (Left Arrow)';
            }
        }

        tabSignIn.addEventListener('click', () => setMode('signin'));
        tabRegister.addEventListener('click', () => setMode('register'));

        navArrowBtn.addEventListener('click', () => {
            const isSignIn = tabSignIn.classList.contains('active');
            setMode(isSignIn ? 'register' : 'signin');
        });

        // Keyboard Arrow Key Switching
        document.addEventListener('keydown', (e) => {
            if (document.activeElement.tagName === 'INPUT') return;
            if (e.key === 'ArrowRight') setMode('register');
            if (e.key === 'ArrowLeft') setMode('signin');
        });

        // Input Focus Audio
        document.querySelectorAll('input').forEach(input => {
            input.addEventListener('focus', () => soundEngine.playFocus());
        });

        // Panel Toggle Controls
        const soundBtn = document.getElementById('toggle-sound');
        soundBtn.addEventListener('click', () => {
            soundEngine.muted = !soundEngine.muted;
            soundBtn.classList.toggle('active', !soundEngine.muted);
            soundBtn.innerHTML = soundEngine.muted ? '<i class="fa-solid fa-volume-xmark"></i>' : '<i class="fa-solid fa-volume-high"></i>';
            if (!soundEngine.muted) soundEngine.playClick();
        });

        const fxBtn = document.getElementById('toggle-fx');
        fxBtn.addEventListener('click', () => {
            soundEngine.playClick();
            gridVisible = !gridVisible;
            fxBtn.classList.toggle('active', gridVisible);
            if (gridVisible) renderScene();
            else {
                cancelAnimationFrame(animationFrameId);
                ctx.clearRect(0, 0, canvas.width, canvas.height);
            }
        });

        const crtBtn = document.getElementById('toggle-crt');
        const scanlineOverlay = document.getElementById('scanline-overlay');
        crtBtn.addEventListener('click', () => {
            soundEngine.playClick();
            const isActive = scanlineOverlay.style.opacity !== '0';
            scanlineOverlay.style.opacity = isActive ? '0' : '1';
            crtBtn.classList.toggle('active', !isActive);
        });

        // Google Social Auth Simulation
        document.getElementById('btn-google').addEventListener('click', () => {
            soundEngine.playClick();
            showToast('REDIRECTING TO GOOGLE OAUTH PROXY...', false);
        });

        // Form Submission Logic
        document.getElementById('auth-form').addEventListener('submit', (e) => {
            e.preventDefault();
            const user = document.getElementById('username').value;
            const pass = document.getElementById('password').value;
            const isRegister = tabRegister.classList.contains('active');

            if (!user || !pass) {
                soundEngine.playError();
                showToast('ERROR: ALL FIELDS ARE REQUIRED', true);
                return;
            }

            if (isRegister) {
                const confirmPass = confirmPasswordInput.value;
                if (pass !== confirmPass) {
                    soundEngine.playError();
                    showToast('ERROR: PASSCODES DO NOT MATCH', true);
                    return;
                }
                soundEngine.playSuccess();
                showToast(`OPERATOR REGISTERED: WELCOME, ${user.toUpperCase()}`, false);
            } else {
                soundEngine.playSuccess();
                showToast(`LINK ESTABLISHED: WELCOME, ${user.toUpperCase()}`, false);
            }
        });

        // Toast Helper
        function showToast(message, isError = false) {
            const toast = document.getElementById('toast');
            const span = toast.querySelector('span');
            const icon = toast.querySelector('i');

            span.textContent = message;
            if (isError) {
                toast.classList.add('error');
                icon.className = 'fa-solid fa-triangle-exclamation';
            } else {
                toast.classList.remove('error');
                icon.className = 'fa-solid fa-circle-check';
            }

            toast.classList.add('show');
            setTimeout(() => toast.classList.remove('show'), 3800);
        }

        // 3D Parallax Tilt Effect
        const mainPanel = document.getElementById('mainPanel');
        document.addEventListener('mousemove', (e) => {
            const xAxis = (window.innerWidth / 2 - e.pageX) / 45;
            const yAxis = (window.innerHeight / 2 - e.pageY) / 45;
            mainPanel.style.transform = `rotateY(${xAxis}deg) rotateX(${yAxis}deg)`;
        });
    </script>
</body>
</html>
