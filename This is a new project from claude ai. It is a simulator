<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Apex World</title>
<style>
  html, body { margin: 0; height: 100%; background: #0a0d18; overflow: hidden; font-family: system-ui, sans-serif; color: #fff; user-select: none; }
  canvas { display: block; touch-action: none; }
  .hud { position: fixed; pointer-events: none; }
  #help { left: 16px; bottom: 16px; font-size: 12px; line-height: 1.7; opacity: .75; background: #0008; padding: 10px 14px; border-radius: 10px; }
  #help b { background: #fff2; border-radius: 4px; padding: 1px 6px; font-weight: 600; }
  #prompt { left: 0; right: 0; bottom: 90px; text-align: center; font-size: 16px; letter-spacing: .08em; opacity: 0; transition: opacity .2s; }
  #prompt span { background: #000a; padding: 8px 16px; border-radius: 20px; border: 1px solid #fff3; }
  #speed { right: 20px; bottom: 16px; font-size: 44px; font-weight: 700; letter-spacing: .02em; text-align: right; opacity: 0; transition: opacity .2s; }
  #speed small { font-size: 14px; opacity: .6; margin-left: 4px; }
  #title { top: 14px; left: 0; right: 0; text-align: center; font-size: 13px; font-weight: 600; letter-spacing: .3em; text-transform: uppercase; opacity: .65; }
  #sw { position: fixed; top: 10px; right: 14px; display: flex; gap: 8px; }
  .sw { width: 26px; height: 26px; border-radius: 50%; border: 2px solid #fff4; cursor: pointer; padding: 0; }
  #fade { position: fixed; inset: 0; background: #000; opacity: 0; pointer-events: none; transition: opacity .25s; }
  #mapwrap { position: fixed; left: 14px; top: 44px; width: 180px; height: 180px; border: 2px solid #fff6; border-radius: 10px; overflow: hidden; background: #123; z-index: 4; transition: width .2s, height .2s, left .2s, top .2s; }
  #mapwrap.big { left: calc(50% - min(43vmin, 360px)); top: calc(50% - min(43vmin, 360px)); width: min(86vmin, 720px); height: min(86vmin, 720px); z-index: 6; box-shadow: 0 0 0 100vmax #0008; }
  #mapwrap.dim { opacity: .35; }
  #mapc { width: 100%; height: 100%; display: block; }
  #pdot, #cdot { position: absolute; transform: translate(-50%, -50%); pointer-events: none; }
  #pdot { color: #fff; font-size: 14px; line-height: 1; text-shadow: 0 0 3px #000, 0 0 6px #000; }
  #mapwrap.big #pdot { font-size: 24px; }
  #cdot { width: 7px; height: 7px; background: #ff3b4e; border: 1px solid #fff; border-radius: 2px; }
  .lbl { position: absolute; transform: translate(-50%, -50%); color: #fff; font-size: 11px; font-weight: 700; letter-spacing: .08em; text-shadow: 0 0 3px #000, 0 0 5px #000; white-space: nowrap; pointer-events: none; }
  #mapwrap:not(.big) .lbl { display: none; }
  #mapc { cursor: pointer; }
  #mapwrap.big #mapc { cursor: crosshair; }
  #maphint { position: absolute; left: 0; right: 0; top: 8px; text-align: center; font-size: 12px; font-weight: 700; letter-spacing: .06em; color: #fff; text-shadow: 0 0 4px #000, 0 0 8px #000; display: none; pointer-events: none; }
  #mapwrap.big #maphint { display: block; }
  #hov { position: absolute; width: 14px; height: 14px; border: 2px solid #ffb703; border-radius: 50%; transform: translate(-50%, -50%); pointer-events: none; display: none; box-shadow: 0 0 6px #000; }
  #svbar { position: fixed; left: 0; right: 0; bottom: 22px; display: none; flex-direction: column; align-items: center; gap: 8px; z-index: 3; pointer-events: none; }
  #svbar.on { display: flex; }
  #svbar button { pointer-events: auto; background: #000a; color: #fff; border: 1px solid #fff5; border-radius: 20px; padding: 9px 18px; cursor: pointer; font-size: 13px; letter-spacing: .06em; }
  #svbar button:hover { background: #000d; }
  #svbar div { font-size: 12px; opacity: .8; text-shadow: 0 0 4px #000; }
  #toast { position: fixed; left: 50%; top: 70px; transform: translateX(-50%); background: #000b; border: 1px solid #fff4; padding: 8px 16px; border-radius: 20px; font-size: 13px; opacity: 0; transition: opacity .2s; pointer-events: none; z-index: 8; }
  #err { position: fixed; inset: 0; display: none; align-items: center; justify-content: center; text-align: center; padding: 24px; }
</style>
</head>
<body>
<div class="hud" id="title">Apex World &middot; The Big City</div>
<div id="sw"></div>
<div class="hud" id="help">
  <div><b>W A S D</b> / arrows &nbsp;move &amp; steer</div>
  <div><b>Shift</b> run &nbsp;&middot;&nbsp; <b>Space</b> jump / handbrake</div>
  <div><b>E</b> get in / out of the car &nbsp;&middot;&nbsp; drag to look &nbsp;&middot;&nbsp; scroll to zoom</div>
  <div><b>M</b> big map &rarr; click a spot for <b>Street View</b> &nbsp;&middot;&nbsp; <b>Shift</b> boost while driving</div>
  <div><b>E</b> at a building door (awning) &rarr; lobby &rarr; elevator &rarr; rooftop</div>
</div>
<div class="hud" id="prompt"><span>Press <b>E</b> to drive</span></div>
<div class="hud" id="speed"><span id="kmh">0</span><small>km/h</small></div>
<div id="fade"></div>
<div id="svbar"><button id="svexit">Exit Street View (Esc)</button><div>drag to look &middot; W / S or &uarr; &darr; to walk &middot; A / D to turn &middot; Shift to move faster &middot; scroll to zoom &middot; M for the map</div></div>
<div id="toast"></div>
<div id="mapwrap"><canvas id="mapc" width="720" height="720"></canvas><div id="cdot"></div><div id="pdot">&#9650;</div><div id="hov"></div><div id="maphint">Click anywhere on the map to drop into Street View</div></div>
<div id="err">3D library failed to load. Open this file in a browser with internet access.</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script>
if (typeof THREE === 'undefined') {
  document.getElementById('err').style.display = 'flex';
} else {
  // ---------- setup ----------
  const scene = new THREE.Scene();
  scene.background = new THREE.Color(0x8fb4dd);
  scene.fog = new THREE.Fog(0x8fb4dd, 70, 280);

  const renderer = new THREE.WebGLRenderer({ antialias: true });
  renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
  renderer.setSize(innerWidth, innerHeight);
  renderer.shadowMap.enabled = true;
  renderer.shadowMap.type = THREE.PCFSoftShadowMap;
  renderer.outputEncoding = THREE.sRGBEncoding;
  renderer.toneMapping = THREE.ACESFilmicToneMapping;
  renderer.toneMappingExposure = 1.0;
  document.body.appendChild(renderer.domElement);

  const camera = new THREE.PerspectiveCamera(55, innerWidth / innerHeight, 0.1, 700);

  scene.add(new THREE.HemisphereLight(0xcfe4ff, 0x8a8478, 1.1));
  const key = new THREE.DirectionalLight(0xfff3dc, 2.4);
  key.castShadow = true;
  key.shadow.mapSize.set(2048, 2048);
  Object.assign(key.shadow.camera, { left: -14, right: 14, top: 14, bottom: -14, near: 1, far: 50 });
  key.shadow.bias = -0.0005;
  scene.add(key, key.target);

  // ---------- NIGHT SKY ----------
  const sky = new THREE.Mesh(
    new THREE.SphereGeometry(400, 32, 16),
    new THREE.ShaderMaterial({
      side: THREE.BackSide, depthWrite: false, fog: false,
      vertexShader: 'varying vec3 vP; void main(){ vP = position; gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0); }',
      fragmentShader: 'varying vec3 vP; void main(){ float h = normalize(vP).y;' +
        'vec3 hor = vec3(0.78, 0.88, 0.97); vec3 mid = vec3(0.42, 0.65, 0.93); vec3 top = vec3(0.16, 0.40, 0.82);' +
        'vec3 c = mix(hor, mid, smoothstep(0.0, 0.25, h)); c = mix(c, top, smoothstep(0.2, 0.85, h));' +
        'c += vec3(1.0, 0.95, 0.85) * exp(-abs(h) * 10.0) * 0.15;' +
        'gl_FragColor = vec4(c, 1.0); }'
    })
  );
  sky.renderOrder = -1; sky.frustumCulled = false;
  scene.add(sky);
  {
    const n = 700, pos = new Float32Array(n * 3);
    for (let i = 0; i < n; i++) {
      const a = Math.random() * Math.PI * 2, y = 0.12 + Math.random() * 0.88, r = Math.sqrt(1 - y * y);
      pos.set([Math.cos(a) * r * 380, y * 380, Math.sin(a) * r * 380], i * 3);
    }
    const g = new THREE.BufferGeometry(); g.setAttribute('position', new THREE.BufferAttribute(pos, 3));
    const stars = new THREE.Points(g, new THREE.PointsMaterial({ color: 0xffffff, size: 1.6, sizeAttenuation: false, transparent: true, opacity: 0.75, fog: false, depthWrite: false }));
    stars.visible = false; stars.frustumCulled = false; sky.add(stars);
    const moon = new THREE.Mesh(new THREE.SphereGeometry(22, 24, 16), new THREE.MeshBasicMaterial({ color: 0xfff6c8, fog: false }));
    moon.position.set(-170, 190, -280); sky.add(moon);
  }

  // ---------- STREET GRID (one tile = one city block + half of each street around it) ----------
  const P = 48;                         // block period: 32 block + 16 street
  const gcan = document.createElement('canvas'); gcan.width = gcan.height = 1024;
  const gx = gcan.getContext('2d');
  const U = 1024 / P;
  gx.fillStyle = '#9a9aa2'; gx.fillRect(0, 0, 1024, 1024);                  // sidewalk
  gx.fillStyle = '#33353c';                                                 // asphalt
  gx.fillRect(0, 0, 8 * U, 1024); gx.fillRect(40 * U, 0, 8 * U, 1024);
  gx.fillRect(0, 0, 1024, 8 * U); gx.fillRect(0, 40 * U, 1024, 8 * U);
  gx.strokeStyle = '#c9c9cf'; gx.lineWidth = 4; gx.strokeRect(8 * U, 8 * U, 32 * U, 32 * U);   // curb
  gx.fillStyle = '#e8b923';                                                 // double yellow centre lines
  for (const [a, b] of [[0.1, 0.35]]) {
    gx.fillRect(a * U, 12 * U, (b - a) * U, 24 * U); gx.fillRect(1024 - b * U, 12 * U, (b - a) * U, 24 * U);
    gx.fillRect(12 * U, a * U, 24 * U, (b - a) * U); gx.fillRect(12 * U, 1024 - b * U, 24 * U, (b - a) * U);
  }
  gx.fillStyle = 'rgba(210,214,226,0.85)';                                  // zebra crossings
  for (let v = 0.6; v < 7.6; v += 1.4) {
    for (const y of [8.6, 36.6]) { gx.fillRect(v * U, y * U, 0.7 * U, 2.8 * U); gx.fillRect((40 + v) * U, y * U, 0.7 * U, 2.8 * U); }
    for (const x of [8.6, 36.6]) { gx.fillRect(x * U, v * U, 2.8 * U, 0.7 * U); gx.fillRect(x * U, (40 + v) * U, 2.8 * U, 0.7 * U); }
  }
  gx.fillStyle = 'rgba(210,214,226,0.7)';                                   // stop lines
  for (const y of [7.2, 40.0]) { gx.fillRect(0.5 * U, y * U, 7 * U, 0.35 * U); gx.fillRect(40.5 * U, y * U, 7 * U, 0.35 * U); }
  for (const x of [7.2, 40.0]) { gx.fillRect(x * U, 0.5 * U, 0.35 * U, 7 * U); gx.fillRect(x * U, 40.5 * U, 0.35 * U, 7 * U); }
  const gtex = new THREE.CanvasTexture(gcan);
  gtex.wrapS = gtex.wrapT = THREE.RepeatWrapping;
  gtex.repeat.set(8, 8);
  gtex.anisotropy = 8;
  const ground = new THREE.Mesh(
    new THREE.PlaneGeometry(8 * P, 8 * P),
    new THREE.MeshStandardMaterial({ map: gtex, roughness: 0.85, metalness: 0.05 })
  );
  ground.rotation.x = -Math.PI / 2;
  ground.receiveShadow = true;
  scene.add(ground);

  // ---------- FACADES: one texture set per district ----------
  function makeFacades(palettes, walls, seed0) {
    const out = [];
    palettes.forEach((pal, n) => {
      let sd = seed0 + n * 17; const r = () => (sd = (sd * 16807) % 2147483647) / 2147483647;
      const cm = document.createElement('canvas'); cm.width = cm.height = 256;
      const a = cm.getContext('2d');
      a.fillStyle = walls[n % walls.length]; a.fillRect(0, 0, 256, 256);
      for (let y = 0; y < 8; y++) for (let x = 0; x < 8; x++) {
        a.fillStyle = r() < 0.7 ? pal[Math.floor(r() * pal.length)] : '#2c3e56';
        a.fillRect(x * 32 + 6, y * 32 + 6, 20, 22);
      }
      const tm = new THREE.CanvasTexture(cm);
      tm.wrapS = tm.wrapT = THREE.RepeatWrapping; tm.anisotropy = 4;
      out.push(new THREE.MeshStandardMaterial({ map: tm, roughness: 0.55, metalness: 0.25 }));
    });
    return out;
  }
  const glassSet = makeFacades(
    [['#1d3557', '#2a4a73', '#3d6a9e'], ['#24455f', '#36668a', '#5a8fb8'], ['#1b2f4a', '#2f557f', '#4f7fb0'],
     ['#2a3f55', '#3f6385', '#6b9bc4'], ['#1f3a52', '#345f80', '#5d90b9'], ['#22364d', '#385d82', '#5f93bd']],
    ['#b9b3a8', '#9fa7b3', '#c9bfae', '#8d96a3', '#b8a898', '#a3adb8'], 100);
  const midSet = makeFacades(
    [['#2a3f55', '#3f6385', '#6b9bc4'], ['#3b3b44', '#55556a', '#7a7a92'], ['#35424d', '#4f6676', '#7f9aaa'], ['#3e3a33', '#5f574a', '#857a68']],
    ['#c9bfae', '#b8a898', '#d2c8b4', '#aaa497'], 300);
  const brickSet = makeFacades(
    [['#2f2a28', '#4a3f3a', '#6a5a52'], ['#26303b', '#3d5064', '#5e7a94'], ['#332b24', '#52453a', '#7a6757'], ['#2a2a30', '#45454f', '#666674'], ['#30302a', '#4d4d40', '#6e6e5a']],
    ['#a0553b', '#8c4a35', '#b5654a', '#97604a', '#9a6b4d'], 500);
  const warehouseSet = makeFacades(
    [['#4a5560', '#66737f', '#8896a3'], ['#3f4a55', '#5a6773', '#7d8b98'], ['#50575e', '#6c747c', '#8f979f']],
    ['#8a8e94', '#9a9fa6', '#7d8288'], 700);
  const DIST = {
    core: { mats: glassSet, hmin: 34, hspan: 150, pow: 1.25 },
    mid:  { mats: midSet, hmin: 20, hspan: 85, pow: 1.6 },
    res:  { mats: brickSet, hmin: 10, hspan: 26, pow: 1.1 },
    ind:  { mats: warehouseSet, hmin: 7, hspan: 14, pow: 1.0 },
  };
  let curD = DIST.core;
  const roofMat = new THREE.MeshStandardMaterial({ color: 0x6d7078, roughness: 0.9 });
  const crownMat = new THREE.MeshStandardMaterial({ color: 0xb39b6a, emissive: 0xffa94d, emissiveIntensity: 0.25, roughness: 0.6 });
  const spireMat = new THREE.MeshStandardMaterial({ color: 0x9aa0b4, metalness: 0.8, roughness: 0.3 });
  const tankMat = new THREE.MeshStandardMaterial({ color: 0x5a3f2a, roughness: 0.9 });
  const beaconMat = new THREE.MeshBasicMaterial({ color: 0xff1414 });
  const spireGeo = new THREE.CylinderGeometry(0.12, 0.55, 1, 8).translate(0, 0.5, 0);
  const beaconGeo = new THREE.SphereGeometry(0.6, 8, 6);
  const tankGeo = new THREE.CylinderGeometry(1.3, 1.3, 2.6, 12);
  const tankCapGeo = new THREE.ConeGeometry(1.5, 1.0, 12);
  const stiltGeo = new THREE.BoxGeometry(1.8, 1.2, 1.8);

  // ---------- NEON SIGNS ----------
  const signDefs = [['PIZZA', '#ff3d6e'], ['HOTEL', '#4fc3ff'], ['DELI', '#ffd166'], ['BROADWAY', '#c77dff'], ['DINER', '#ff9f1c'],
                    ['CAFE', '#2ec4b6'], ['TAXI', '#ffee32'], ['BAR', '#ff4f8b'], ['24 HR', '#7dff9b']];
  const signMats = signDefs.map(([txt, col]) => {
    const c = document.createElement('canvas'); c.width = 256; c.height = 64;
    const x = c.getContext('2d');
    x.fillStyle = '#080a12'; x.fillRect(0, 0, 256, 64);
    x.strokeStyle = col; x.lineWidth = 3; x.strokeRect(4, 4, 248, 56);
    x.font = 'bold 38px system-ui, sans-serif'; x.textAlign = 'center'; x.textBaseline = 'middle';
    x.shadowColor = col; x.shadowBlur = 14; x.fillStyle = col; x.fillText(txt, 128, 34); x.fillText(txt, 128, 34);
    return new THREE.MeshBasicMaterial({ map: new THREE.CanvasTexture(c), color: 0xb8b8b8 });
  });
  const signGeo = new THREE.PlaneGeometry(1, 0.25);
  const doorMat = new THREE.MeshStandardMaterial({ color: 0x1b3550, emissive: 0x2a6fb0, emissiveIntensity: 0.6, metalness: 0.5, roughness: 0.2 });
  const awnMat = new THREE.MeshStandardMaterial({ color: 0xc0392b, roughness: 0.7 });
  const doorGeoX = new THREE.BoxGeometry(0.3, 3, 2.4), doorGeoZ = new THREE.BoxGeometry(2.4, 3, 0.3);
  const awnGeoX = new THREE.BoxGeometry(1.4, 0.18, 3.4), awnGeoZ = new THREE.BoxGeometry(3.4, 0.18, 1.4);
  let curBX = 0, curBZ = 0;

  // ---------- STREET LAMPS (+ fake light pools) ----------
  const poleGeo = new THREE.CylinderGeometry(0.07, 0.1, 6, 6).translate(0, 3, 0);
  const lampGeo = new THREE.SphereGeometry(0.3, 8, 6).translate(0, 6.1, 0);
  const poolGeo = new THREE.PlaneGeometry(16, 16).rotateX(-Math.PI / 2).translate(0, 0.04, 0);
  const poleMat = new THREE.MeshStandardMaterial({ color: 0x1a1c26, metalness: 0.6, roughness: 0.5 });
  const lampMat = new THREE.MeshBasicMaterial({ color: 0xdcdcdc });
  const poolTex = (() => {
    const c = document.createElement('canvas'); c.width = c.height = 128;
    const x = c.getContext('2d'), g = x.createRadialGradient(64, 64, 0, 64, 64, 64);
    g.addColorStop(0, 'rgba(255,200,120,0.9)'); g.addColorStop(1, 'rgba(255,200,120,0)');
    x.fillStyle = g; x.fillRect(0, 0, 128, 128); return new THREE.CanvasTexture(c);
  })();
  const poolMat = new THREE.MeshBasicMaterial({ map: poolTex, transparent: true, opacity: 0.0, blending: THREE.AdditiveBlending, depthWrite: false });

  // ---------- CHUNKS: the city is generated around you as you move ----------
  const chunks = new Map();
  function chunkRng(i, j) {
    let a = ((i * 73856093) ^ (j * 19349663) ^ 0x9e3779b9) | 0;
    return () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296; };
  }
  function addBox(ch, cx, cz, w, d, y0, y1, rng, mi, over) {
    const h = y1 - y0, g = new THREE.BoxGeometry(w, h, d), uv = g.attributes.uv;
    const ou = rng(), ov = rng();
    for (let f = 0; f < 6; f++) {
      const span = f < 2 ? d : w;
      for (let v = 0; v < 4; v++) {
        const k = f * 4 + v;
        if (f === 2 || f === 3) uv.setXY(k, 0, 0);
        else uv.setXY(k, uv.getX(k) * span / 25.6 + ou, uv.getY(k) * h / 28.8 + ov);
      }
    }
    const fm = over || curD.mats[mi];
    const m = new THREE.Mesh(g, [fm, fm, roofMat, roofMat, fm, fm]);
    m.position.set(cx, y0 + h / 2, cz);
    scene.add(m); ch.meshes.push(m); ch.geos.push(g);
  }
  function addShared(ch, geo, mat, x, y, z, sx = 1, sy = 1, sz = 1) {
    const m = new THREE.Mesh(geo, mat); m.position.set(x, y, z); m.scale.set(sx, sy, sz);
    scene.add(m); ch.meshes.push(m); return m;
  }
  function addBuilding(ch, x0, z0, w, d, rng, special) {
    const mi = Math.floor(rng() * curD.mats.length);
    const h = special ? 185 : curD.hmin + Math.pow(rng(), curD.pow) * curD.hspan;
    const cx = x0 + w / 2, cz = z0 + d / 2;
    const rec = { x0, x1: x0 + w, z0, z1: z0 + d, h, door: null, top: { x0, x1: x0 + w, z0, z1: z0 + d, y: h } };
    ch.rects.push(rec);
    {
      let nx = 0, nz = 0, dx, dz;
      if (x0 - curBX < 4) { nx = -1; dx = x0; dz = cz; }
      else if (curBX + 32 - (x0 + w) < 4) { nx = 1; dx = x0 + w; dz = cz; }
      else if (z0 - curBZ < 4) { nz = -1; dx = cx; dz = z0; }
      else { nz = 1; dx = cx; dz = z0 + d; }
      rec.door = { x: dx, z: dz, nx, nz };
      addShared(ch, nx ? doorGeoX : doorGeoZ, doorMat, dx + nx * 0.12, 1.5, dz + nz * 0.12);
      addShared(ch, nx ? awnGeoX : awnGeoZ, awnMat, dx + nx * 0.8, 3.3, dz + nz * 0.8);
    }
    if (special || (h > 48 && rng() > 0.4)) {            // stepped Art-Deco style tower
      const h1 = h * 0.55, h2 = h * 0.82;
      rec.top = { x0: cx - w * 0.225, x1: cx + w * 0.225, z0: cz - d * 0.225, z1: cz + d * 0.225, y: h };
      addBox(ch, cx, cz, w, d, 0, h1, rng, mi);
      addBox(ch, cx, cz, w * 0.72, d * 0.72, h1, h2, rng, mi);
      addBox(ch, cx, cz, w * 0.45, d * 0.45, h2, h, rng, mi, special ? crownMat : null);
      addShared(ch, spireGeo, spireMat, cx, h, cz, special ? 1.6 : 1, h * (special ? 0.2 : 0.14), special ? 1.6 : 1);
      addShared(ch, beaconGeo, beaconMat, cx, h + h * (special ? 0.2 : 0.14), cz, special ? 1.5 : 1, special ? 1.5 : 1, special ? 1.5 : 1);
    } else {
      addBox(ch, cx, cz, w, d, 0, h, rng, mi);
      if (h < 55 && rng() > 0.45) {                      // rooftop water tank
        const tx = cx + (rng() - 0.5) * w * 0.4, tz = cz + (rng() - 0.5) * d * 0.4;
        addShared(ch, stiltGeo, tankMat, tx, h + 0.6, tz);
        addShared(ch, tankGeo, tankMat, tx, h + 2.5, tz);
        addShared(ch, tankCapGeo, tankMat, tx, h + 4.3, tz);
      } else if (h > 75) addShared(ch, beaconGeo, beaconMat, cx, h + 0.8, cz);
    }
    if (!special && rng() > 0.45) {                      // neon sign at street level
