    svPos.x = clampW(svPos.x, 6); svPos.z = clampW(svPos.z, 6);
    ground.position.set(Math.round(svPos.x / P) * P, 0, Math.round(svPos.z / P) * P);
    updateTaxis(t, svPos.x, svPos.z);
    key.position.set(svPos.x + 14, 26, svPos.z + 10); key.target.position.set(svPos.x, 0, svPos.z);
    beaconMat.color.setRGB(1, 0.08, 0.08).multiplyScalar(Math.sin(t * 3) > 0.2 ? 1 : 0.15);
    camera.position.set(svPos.x, 2.0, svPos.z);
    camera.lookAt(svPos.x + Math.cos(svYaw) * Math.cos(svPitch), 2.0 + Math.sin(svPitch), svPos.z + Math.sin(svYaw) * Math.cos(svPitch));
    sky.position.copy(camera.position);
  }

  addEventListener('resize', () => {
    camera.aspect = innerWidth / innerHeight; camera.updateProjectionMatrix();
    renderer.setSize(innerWidth, innerHeight);
  });

  // ---------- loop ----------
  const clock = new THREE.Clock();
  const target = new THREE.Vector3();
  (function loop() {
    requestAnimationFrame(loop);
    const dt = Math.min(clock.getDelta(), 0.05), t = clock.elapsedTime;
    if (svMode) { stepSV(dt, t); renderer.render(scene, camera); updateMap(); return; }
    const fx = -Math.cos(camYaw), fz = -Math.sin(camYaw);   // camera forward on the ground
    const rx = -fz, rz = fx;                                 // camera right

    if (!driving) {
      // ----- walking -----
      let fwd = (down('KeyW', 'ArrowUp') ? 1 : 0) - (down('KeyS', 'ArrowDown') ? 1 : 0);
      let rgt = (down('KeyD', 'ArrowRight') ? 1 : 0) - (down('KeyA', 'ArrowLeft') ? 1 : 0);
      let dx = fx * fwd + rx * rgt, dz = fz * fwd + rz * rgt;
      const len = Math.hypot(dx, dz);
      const speed = down('ShiftLeft', 'ShiftRight') ? 8 : 4;
      if (len > 0) {
        dx /= len; dz /= len;
        hs.vx += (dx * speed - hs.vx) * Math.min(1, dt * 10);
        hs.vz += (dz * speed - hs.vz) * Math.min(1, dt * 10);
        const want = Math.atan2(-dz, dx);
        hs.h += angDiff(hs.h, want) * Math.min(1, dt * 12);
      } else {
        hs.vx *= Math.max(0, 1 - dt * 10); hs.vz *= Math.max(0, 1 - dt * 10);
      }
      if (hs.y <= gy && down('Space')) hs.vy = 7.5;
      hs.vy -= 22 * dt; hs.y += hs.vy * dt;
      if (hs.y < gy) { hs.y = gy; hs.vy = 0; }
      hs.x += hs.vx * dt; hs.z += hs.vz * dt;
      if (inside) clampLobby(); else if (roofMode) clampRoof(); else {
        push(hs, 0.35);
        hs.x = Math.max(-WORLD + 4, Math.min(WORLD - 4, hs.x)); hs.z = Math.max(-WORLD + 4, Math.min(WORLD - 4, hs.z));
      }
      // the car is solid too
      const cdx = hs.x - cs.x, cdz = hs.z - cs.z;
      const lx_ = cdx * Math.cos(cs.h) - cdz * Math.sin(cs.h);
      const lz_ = cdx * Math.sin(cs.h) + cdz * Math.cos(cs.h);
      if (Math.abs(lx_) < 2.45 && Math.abs(lz_) < 1.2 && hs.y < 1.1) {
        const px = 2.45 - Math.abs(lx_), pz = 1.2 - Math.abs(lz_);
        let nx = lx_, nz = lz_;
        if (px < pz) nx = Math.sign(lx_ || 1) * 2.45; else nz = Math.sign(lz_ || 1) * 1.2;
        hs.x = cs.x + nx * Math.cos(cs.h) + nz * Math.sin(cs.h);
        hs.z = cs.z - nx * Math.sin(cs.h) + nz * Math.cos(cs.h);
      }
      const spd = Math.hypot(hs.vx, hs.vz);
      hs.walk += dt * spd * 2.4;
      const amp = Math.min(spd / 4, 1.6) * 0.7 * (hs.y > gy + 0.05 ? 0.3 : 1);
      legL.rotation.z = Math.sin(hs.walk) * amp;  legR.rotation.z = -Math.sin(hs.walk) * amp;
      armL.rotation.z = -Math.sin(hs.walk) * amp; armR.rotation.z = Math.sin(hs.walk) * amp;
      body.position.y = Math.abs(Math.sin(hs.walk)) * 0.04 * Math.min(spd, 4) / 4;
      hero.position.set(hs.x, hs.y, hs.z);
      hero.rotation.y = hs.h;
      updateAction();
      speedEl.style.opacity = 0;
      target.set(hs.x, hs.y + 1.4, hs.z);
    } else {
      // ----- driving -----
      const gas = down('KeyW', 'ArrowUp'), brake = down('KeyS', 'ArrowDown');
      const boost = down('ShiftLeft', 'ShiftRight');
      if (gas) cs.v += (cs.v < 0 ? 40 : (boost ? 38 : 20)) * dt;
      else if (brake) cs.v -= (cs.v > 0 ? 40 : 12) * dt;
      else cs.v *= Math.max(0, 1 - dt * 0.5);
      if (down('Space')) cs.v *= Math.max(0, 1 - dt * 3);
      const vmax = boost ? 80 : 48;
      if (cs.v > vmax) cs.v = Math.max(vmax, cs.v - 30 * dt);
      cs.v = Math.max(-12, cs.v);
      const want = ((down('KeyA', 'ArrowLeft') ? 1 : 0) - (down('KeyD', 'ArrowRight') ? 1 : 0));
      cs.steer += (want - cs.steer) * Math.min(1, dt * 7);
      const grip = Math.min(1, Math.abs(cs.v) / 6);
      cs.h += cs.steer * grip * Math.sign(cs.v) * dt * (1.9 - Math.min(Math.abs(cs.v), 48) / 48 * 1.0);
      cs.x += Math.cos(cs.h) * cs.v * dt;
      cs.z -= Math.sin(cs.h) * cs.v * dt;
      if (push(cs, 1.4)) cs.v *= 0.6;
      if (Math.abs(cs.x) > WORLD - 6 || Math.abs(cs.z) > WORLD - 6) {
        cs.x = Math.max(-WORLD + 6, Math.min(WORLD - 6, cs.x)); cs.z = Math.max(-WORLD + 6, Math.min(WORLD - 6, cs.z)); cs.v *= 0.5;
      }
      car.position.set(cs.x, Math.sin(t * 25) * 0.004 * Math.min(1, Math.abs(cs.v) / 20), cs.z);
      car.rotation.y = cs.h;
      car.rotation.z = -cs.steer * Math.min(Math.abs(cs.v) / 48, 1) * 0.05;   // body roll
      car.rotation.x = 0;
      frontWheels.forEach(w => w.rotation.y = cs.steer * 0.45);
      promptEl.style.opacity = 0;
      speedEl.style.opacity = 1;
      kmhEl.textContent = Math.round(Math.abs(cs.v) * 3.6);
      // chase camera drifts behind the car when you stop dragging
      if (t - lastDrag > 1.5) {
        const behind = Math.atan2(Math.sin(cs.h), -Math.cos(cs.h));
        camYaw += angDiff(camYaw, behind) * Math.min(1, dt * 2.5);
      }
      target.set(cs.x, 0.9, cs.z);
    }
    wheels.forEach(w => w.rotation.z -= cs.v * dt / 0.38);

    // endless ground and light follow the player
    const px = driving ? cs.x : hs.x, pz = driving ? cs.z : hs.z, py = (!driving && roofMode) ? gy : 0;
    if (!inside) {
      ground.position.set(Math.round(px / P) * P, 0, Math.round(pz / P) * P);
      updateChunks(px, pz); updateTaxis(t, px, pz);
    }
    beaconMat.color.setRGB(1, 0.08, 0.08).multiplyScalar(Math.sin(t * 3) > 0.2 ? 1 : 0.15);
    key.position.set(px + 14, py + 26, pz + 10); key.target.position.set(px, py, pz);

    // camera
    camera.position.set(
      target.x + Math.cos(camYaw) * Math.cos(camPitch) * camDist,
      target.y + Math.sin(camPitch) * camDist,
      target.z + Math.sin(camYaw) * Math.cos(camPitch) * camDist
    );
    if (inside) {
      camera.position.x = Math.max(I.x - 9.5, Math.min(I.x + 9.5, camera.position.x));
      camera.position.z = Math.max(I.z - 9.5, Math.min(I.z + 9.5, camera.position.z));
      camera.position.y = Math.max(0.5, Math.min(4.6, camera.position.y));
    }
    camera.lookAt(target);
    sky.position.copy(camera.position);
    updateMap();
    renderer.render(scene, camera);
  })();
}
</script>
